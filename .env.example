# Copy this file to ".env" and fill in your keys.  The .env file is gitignored
# and is NEVER committed — your keys stay on your machine only.

# --- Voices (you need at least one) ---

# ElevenLabs — primary voice. Get a key: https://elevenlabs.io  (Profile -> API key)
ELEVENLABS_API_KEY=

# MiniMax — fallback voice, strong Chinese/Cantonese. Get a key: https://www.minimax.io
MINIMAX_API_KEY=

# --- Optional overrides (defaults shown) ---
# SPEAK_EL_VOICE_ID=21m00Tcm4TlvDq8ikWAM     # ElevenLabs voice id
# SPEAK_EL_MODEL=eleven_flash_v2_5           # ElevenLabs model (flash = low latency)
# SPEAK_MM_MODEL=speech-2.8-hd               # MiniMax model
# SPEAK_SPEED=1.0                            # 0.5 - 2.0
# SPEAK_CAPTURE_DELAY=0.2                    # pause before Cmd+C on auto-capture
